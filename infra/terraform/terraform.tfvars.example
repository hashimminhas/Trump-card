# Copy this file to terraform.tfvars and fill in your real values.
# terraform.tfvars itself must NEVER be committed (it's in .gitignore) —
# this .example file is the only one that goes into the repo.

my_ip_cidr           = "203.0.113.42/32"          # replace with YOUR IP from whatismyip.com
ssh_public_key_path  = "~/.ssh/trump-card-aws.pub" # replace if you saved your key elsewhere

# Everything else has sensible defaults in variables.tf — override here only if you want to.
# aws_region    = "eu-north-1"
# instance_type = "t3.micro"
